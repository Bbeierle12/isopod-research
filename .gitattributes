# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Vault content — always LF in the repo
*.md   text eol=lf
*.json text eol=lf
*.canvas text eol=lf
*.css  text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.pdf  binary
*.mp4  binary
*.zip  binary
